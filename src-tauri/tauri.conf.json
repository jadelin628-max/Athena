{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athena",
  "version": "1.13.1",
  "identifier": "com.athena.memory",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Athena · 考研知识点记忆",
        "width": 500,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
